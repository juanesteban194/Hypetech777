# =============================================================================
# Environment variables, documented one by one (docs/PROMPT_MAESTRO.md §0.6).
#
#   cp .env.example .env.local     # local development only; .env.local is git-ignored
#
# Never commit real values. NEXT_PUBLIC_* variables are inlined into the browser bundle,
# so they must never hold a secret. On Vercel, store every other variable as type "Secret".
# The app builds with none of the optional variables below (phase 0 needs no cloud secrets).
# =============================================================================


# --- Site (phase 0) ----------------------------------------------------------

# Canonical origin of the site, no trailing slash. Optional: when empty the app falls back to the
# Vercel production URL, then the Vercel deployment URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Supabase (phase 2 onwards) ----------------------------------------------
# Local stack: `pnpm db:start`, then `pnpm exec supabase status` prints every value.
# Hosted: Project settings > API keys. Use one project for `staging`, another for `production`.

# API URL of the project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable key (sb_publishable_...). Safe for the browser: row level security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). SERVER ONLY: it bypasses row level security. Used by Server Actions,
# route handlers and scripts. Never expose it, never log it.
SUPABASE_SECRET_KEY=


# --- Cloudflare Turnstile (phase 4 onwards) -----------------------------------
# Anti-spam for public forms. Cloudflare publishes always-pass test keys for local development
# and CI; use real keys only on deployed environments.

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SERVER ONLY. Verifies the token on every public Server Action.
TURNSTILE_SECRET_KEY=


# --- Wompi payments (phase 4 onwards) -----------------------------------------
# Sandbox keys locally and on previews; production keys only in the Vercel Production
# environment (and only from phase 8). Each environment has its own four values.

# Public key: pub_test_... (sandbox) or pub_prod_... (production).
WOMPI_PUBLIC_KEY=
# Private key: prv_test_... / prv_prod_.... SERVER ONLY: required to query transactions and refunds.
WOMPI_PRIVATE_KEY=
# Events secret: test_events_... / prod_events_.... Validates the checksum of webhook events.
WOMPI_EVENTS_SECRET=
# Integrity secret: test_integrity_... / prod_integrity_.... Signs the amount of each checkout.
WOMPI_INTEGRITY_SECRET=


# --- Internal routes (phase 4 onwards) ----------------------------------------

# Random string (>= 32 characters) that authorises server-to-server calls such as the payment
# reconciliation job (Authorization: Bearer <value>).
CRON_SECRET=


# --- E-mail with Resend (optional, phase 7) -----------------------------------
# Needed for internal alerts (orders in review, failed jobs) and optional customer e-mails.

RESEND_API_KEY=
# Verified sender, e.g. pedidos@your-domain.
RESEND_FROM=
